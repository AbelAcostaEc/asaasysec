---
import { Image } from "astro:assets";
import { projects } from "../../data/projects.js";

const featuredProject = projects[0];
const otherProjects = projects.slice(1);
---

<!-- Portfolio -->
<section id="portfolio" class="portfolio">
	<div class="container">
		<div class="portfolio-header">
			<div class="section-tag">Portafolio</div>
			<h2 class="section-title">Soluciones Desarrolladas</h2>
			<div class="header-line"></div>
		</div>

		{featuredProject && (
			<div class="glass-card featured-project-card">
				<div class="featured-grid">
					<div class="project-image-wrapper">
						<div class="technical-grid-overlay"></div>
						<div class="img-container">
							<Image src={featuredProject.image} alt={featuredProject.title} width={800} quality={85} loading="eager" />
						</div>
					</div>
					<div class="project-details">
						<div class="project-category-badge">{featuredProject.category}</div>
						<h3 class="project-title">{featuredProject.title}</h3>
						
						<div class="project-problem-solution">
							<div class="info-block problem-block">
								<span class="block-title">Problema:</span>
								<p>{featuredProject.problem}</p>
							</div>
							<div class="info-block solution-block">
								<span class="block-title">Solución:</span>
								<p>{featuredProject.solution}</p>
							</div>
						</div>

						<div class="tech-tags">
							{featuredProject.techStack.map((tech) => (
								<span class="tag">{tech}</span>
							))}
						</div>
					</div>
				</div>
			</div>
		)}

		{otherProjects.length > 0 && (
			<div class="other-projects-grid">
				{otherProjects.map((project) => (
					<div class="glass-card project-card">
						<div class="project-card-image">
							<Image src={project.image} alt={project.title} width={400} quality={80} />
						</div>
						<div class="project-card-content">
							<div class="project-category-badge">{project.category}</div>
							<h3>{project.title}</h3>
							
							<div class="project-problem-solution">
								<div class="info-block problem-block">
									<span class="block-title">Problema:</span>
									<p>{project.problem}</p>
								</div>
								<div class="info-block solution-block">
									<span class="block-title">Solución:</span>
									<p>{project.solution}</p>
								</div>
							</div>

							<div class="tech-tags">
								{project.techStack.map((tech) => (
									<span class="tag">{tech}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		)}
	</div>
</section>
