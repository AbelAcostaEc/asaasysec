---
import { Image } from "astro:assets";
import fotoAbel from "../../assets/images/foto_Abel.jpeg";
import data from "../../data/general.json";
---

<!-- Hero Section -->
<section class="hero">
	<div class="container">
		<div class="hero-content">
			<div class="hero-text">
				<h1>Hola, soy <br /><span>{data.name}</span></h1>
				<p>{data.title}, {data.description}</p>
				<div class="hero-btns">
					<a href="#contact" class="btn btn-primary">Contáctame</a>
					<a href="#portfolio" class="btn btn-outline">Ver Proyectos</a>
				</div>
			</div>
			<div class="hero-img">
				<div class="img-wrapper">
					<Image src={fotoAbel} alt={data.name} width={500} quality={90} loading="eager" />
				</div>
			</div>
		</div>
	</div>
</section>
