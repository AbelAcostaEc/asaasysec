---
import data from "../../data/general.json";
const { main_skills } = data;
---

<!-- Hero Section -->
<section class="hero">
	<div class="container">
		<div class="hero-badge">
			<span class="dot">&nbsp;</span>
			<span>Disponible para oportunidades y proyectos</span>
		</div>
		<div class="hero-content">
			<div class="hero-text">
				<h1>Desarrollo sistemas empresariales y soluciones Full Stack</h1>
				<p>Desarrollador Full Stack enfocado en PHP y Laravel, con experiencia en sistemas empresariales, APIs REST, Angular, automatizaciones e integraciones.</p>
				<div class="skills-container">
					{main_skills.map((skill) => <span class="skill">{skill}</span>)}
				</div>
				<div class="hero-btns">
					<a href="#contact" class="btn btn-primary">Contactarme</a>
					<a href="#portfolio" class="btn btn-outline btn-outline-white">Ver proyectos</a>
				</div>
			</div>
		</div>
	</div>
</section>
