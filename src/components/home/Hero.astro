---
import { Image } from "astro:assets";
import fotoAbel from "../../assets/images/foto_Abel.jpeg";
---

<!-- Hero Section -->
<section class="hero">
	<div class="container">
		<div class="hero-content">
			<div class="hero-text">
				<h1>Hola, soy <br /><span>Abel Acosta</span></h1>
				<p>Tecnólogo en Análisis de sistemas, Desarrollador Full Stack especializado en crear aplicaciones web y móviles funcionales, combinando código eficiente con una experiencia de usuario excepcional.</p>
				<div class="hero-btns">
					<a href="#contact" class="btn btn-primary">Contáctame</a>
					<a href="#portfolio" class="btn btn-outline">Ver Proyectos</a>
				</div>
			</div>
			<div class="hero-img">
				<div class="img-wrapper">
					<Image src={fotoAbel} alt="Abel Acosta" width={500} quality={90} loading="eager" />
				</div>
			</div>
		</div>
	</div>
</section>
