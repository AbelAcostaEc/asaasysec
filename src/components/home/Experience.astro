---
import data from "../../data/general.json";
const { experience } = data;
---

<!-- Experience -->
<section id="experience" class="experience">
	<div class="container">
		<div class="experience-grid">
			<div class="experience-intro">
				<div class="section-tag">Experiencia</div>
				<h2 class="section-subtitle">Trayectoria Profesional</h2>
				<p class="intro-description">
					Experiencia profesional en desarrollo y modernización de sistemas empresariales, APIs, integraciones y aplicaciones web, móviles y de escritorio.
				</p>
				<p class="intro-note">
					Mi experiencia profesional como desarrollador comienza en 2023. Antes de eso realicé una pasantía enfocada en QA y soporte de pruebas.
				</p>
				<div class="accent-line"></div>
			</div>

			<div class="experience-timeline">
				{
					experience.map((item, index) => {
						return (
							<div class:list={["timeline-item", { "timeline-item--primary": index === 0 }]}> 
								<div class="timeline-dot"></div>
								{index === 0 && <span class="experience-label">Experiencia actual</span>}
								<div class="timeline-header">
									<div class="header-main">
										<h3>{item.position}</h3>
										<span class="company">{item.company}</span>
									</div>
									<div class="period-badge">{item.period}</div>
								</div>
								<ul class="responsibilities">
									{item.responsibilities.map((resp, idx) => (
										<li>
											<span class="num">0{idx + 1}</span>
											<span class="text">{resp}</span>
										</li>
									))}
								</ul>
							</div>
						);
					})
				}
			</div>
		</div>
	</div>
</section>
