---
import { withBase } from "../utils/paths";
---

<!-- Navbar -->
<nav class="navbar">
	<div class="container">
		<a href={withBase("/")} class="logo">Abel<span>.</span></a>
		<div class="nav-links">
			<a href={withBase("/#about")}>Sobre Mí</a>
			<a href={withBase("/#experience")}>Experiencia</a>
			<a href={withBase("/#portfolio")}>Portafolio</a>
			<a href={withBase("/blog")}>Blog</a>
			<a href={withBase("/#contact")}>Contacto</a>
		</div>
	</div>
</nav>

<script>
    const navbar = document.querySelector('.navbar');

    window.addEventListener('scroll', () => {
        navbar?.classList.toggle(
            'scrolled',
            window.scrollY > 50
        );
    });
</script>
