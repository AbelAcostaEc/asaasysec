---
import "../styles/main.scss";
import general from "../data/general.json";
import { absoluteUrl, withBase } from "../utils/paths";

const defaultTitle = `${general.name} | ${general.role}`;
const defaultDescription =
	"Portafolio de Abel Acosta, Desarrollador Full Stack especializado en Laravel, Angular, aplicaciones web, móviles y automatización con N8N.";
const defaultKeywords = [
	"Abel Acosta",
	"Desarrollador Full Stack",
	"Web Developer",
	"Laravel",
	"Angular",
	"N8N",
	"PHP",
	"JavaScript",
	"Portfolio",
	"Quito",
	"Ecuador",
];

const {
	title = defaultTitle,
	description = defaultDescription,
	keywords = defaultKeywords,
	type = "website",
	image = "/og-image.jpeg",
	canonical,
	publishedTime,
	modifiedTime,
	tags = [],
	noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://abelacostaec.github.io");
const canonicalUrl = absoluteUrl(canonical ?? Astro.url.pathname, site);
const imageUrl = absoluteUrl(image, site);
const siteUrl = absoluteUrl("/", site);
const robots = noindex ? "noindex, nofollow" : "index, follow";
const keywordContent = Array.isArray(keywords) ? keywords.join(", ") : keywords;
const fontFaces = [
	["Inter", 100, "inter-v20-latin-100.woff2"],
	["Inter", 200, "inter-v20-latin-200.woff2"],
	["Inter", 300, "inter-v20-latin-300.woff2"],
	["Inter", 400, "inter-v20-latin-regular.woff2"],
	["Inter", 500, "inter-v20-latin-500.woff2"],
	["Inter", 600, "inter-v20-latin-600.woff2"],
	["Inter", 700, "inter-v20-latin-700.woff2"],
	["Outfit", 400, "outfit-v15-latin-regular.woff2"],
	["Outfit", 500, "outfit-v15-latin-500.woff2"],
	["Outfit", 700, "outfit-v15-latin-700.woff2"],
	["Outfit", 800, "outfit-v15-latin-800.woff2"],
	["Geist Sans", 100, "geist-sans-latin-100-normal.woff2"],
	["Geist Sans", 200, "geist-sans-latin-200-normal.woff2"],
	["Geist Sans", 300, "geist-sans-latin-300-normal.woff2"],
	["Geist Sans", 400, "geist-sans-latin-400-normal.woff2"],
	["Geist Sans", 500, "geist-sans-latin-500-normal.woff2"],
	["Geist Sans", 600, "geist-sans-latin-600-normal.woff2"],
	["Geist Sans", 700, "geist-sans-latin-700-normal.woff2"],
	["Geist Sans", 800, "geist-sans-latin-800-normal.woff2"],
	["Geist Sans", 900, "geist-sans-latin-900-normal.woff2"],
]
	.map(
		([family, weight, file]) => `@font-face {
	font-display: swap;
	font-family: '${family}';
	font-style: normal;
	font-weight: ${weight};
	src: url('${withBase(`/fonts/${file}`)}') format('woff2');
}`
	)
	.join("\n");

const structuredData =
	type === "article"
		? {
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: title,
				description,
				url: canonicalUrl,
				image: imageUrl,
				datePublished: publishedTime,
				dateModified: modifiedTime ?? publishedTime,
				author: {
					"@type": "Person",
					name: general.name,
					url: siteUrl,
				},
				publisher: {
					"@type": "Person",
					name: general.name,
				},
				keywords: tags,
			}
		: {
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "Person",
						name: general.name,
						jobTitle: general.role,
						url: siteUrl,
						image: imageUrl,
						email: general.contact.email,
						telephone: general.contact.phone,
						address: {
							"@type": "PostalAddress",
							addressLocality: "Quito",
							addressCountry: "EC",
						},
						sameAs: [general.contact.github, general.contact.linkedin],
						knowsAbout: defaultKeywords.slice(3, 9),
					},
					{
						"@type": "WebSite",
						name: defaultTitle,
						url: siteUrl,
						description: defaultDescription,
						inLanguage: "es",
					},
				],
			};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
		<link rel="icon" href={withBase("/favicon.ico")} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywordContent} />
		<meta name="author" content={general.name} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#0f172a" />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:site_name" content={general.name} />
		<meta property="og:locale" content="es_EC" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
		<style is:inline set:html={fontFaces}></style>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
		<div class="fixed-decorations">
			<div class="technical-grid"></div>
			<div class="glow-cyan glow-top"></div>
			<div class="glow-cyan glow-bottom"></div>
		</div>
		<slot />
		<script>
			import "../scripts/main.js";
		</script>
	</body>
</html>
